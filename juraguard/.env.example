# Cloud billing (all required when DEPLOYMENT_MODE=cloud unless explicitly disabled)
DEPLOYMENT_MODE=self_hosted
POLAR_BILLING_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_MONTHLY_PRODUCT_ID=
POLAR_ANNUAL_PRODUCT_ID=
POLAR_BETA_DISCOUNT_ID=
POLAR_SERVER_URL=https://api.polar.sh
# Explicitly opt in only while operating a free-beta deployment.
CLOUD_BETA_ACCESS=false

# Self-hosted commercial validation
LICENSE_VALIDATION_URL=
LICENSE_SIGNING_PUBLIC_KEY=
LICENSE_VALIDATION_TIMEOUT=5
LICENSE_GRACE_DAYS=7
LICENSE_DOCUMENT_CLOCK_SKEW_SECONDS=300
LICENSE_DOCUMENT_MAX_LIFETIME_SECONDS=86400
# Optional managed encryption rotation: current key first, previous keys after it.
LICENSE_ENCRYPTION_KEYS=

# Cloud license server only; never distribute this private key to self-hosted instances.
LICENSE_SIGNING_PRIVATE_KEY=
